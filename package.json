{
  "name": "portalpulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:core": "tsc",
    "build:probe": "node scripts/build-probe.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "npm run build:core && npm run build:web-tests && node --test tests/*.test.mjs",
    "cli": "node dist/cli/main.js",
    "build:web-tests": "tsc -p tsconfig.web.json",
    "dev": "vite",
    "build": "npm run build:core && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@ethereumjs/evm": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "solc": "0.8.24",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "ws": "8.22.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
