{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/core/**/*.ts",
    "src/cli/**/*.ts",
    "src/demo/**/*.ts"
  ]
}
